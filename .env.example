# Backend server per environment.
# Flutter reads API_BASE_URL as a compile-time --dart-define, NOT this file.
#
#   DEV server  : https://api-dev.oclyx.com   (local dev + `develop` branch)
#   PROD server : http://100.77.112.35:8083    (`main` only — existing API server)
#
# Branch -> server:
#   - local `flutter run` & develop builds -> DEV  (the compile-time default in
#     lib/core/constants/app_constants.dart, so no flag needed)
#   - main / production release            -> existing server, injected at build:
#       flutter build apk --dart-define=API_BASE_URL=http://100.77.112.35:8083
#
# Convenience wrapper that resolves the server from the current git branch:
#   scripts/flutter_env.sh run                  # DEV unless on main
#   scripts/flutter_env.sh build apk --release  # PROD on main, else DEV
#
# Override explicitly with APP_ENV when needed:
#   APP_ENV=prod scripts/flutter_env.sh build apk --release
API_TIMEOUT=30
LOG_LEVEL=debug
