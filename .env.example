# Backend server per environment.
# Flutter reads API_BASE_URL as a compile-time --dart-define, NOT this file.
#
#   PROD server : https://api.oclyx.com       (default for every build)
#   DEV server  : https://api-dev.oclyx.com   (opt-in)
#
# The default lives in lib/core/constants/app_constants.dart, so no flag is
# needed for PROD. To target DEV:
#   flutter run --dart-define=API_BASE_URL=https://api-dev.oclyx.com
#   APP_ENV=dev scripts/flutter_env.sh run
API_TIMEOUT=30
LOG_LEVEL=debug
